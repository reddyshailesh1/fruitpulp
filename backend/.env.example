# Server Port
PORT=5000

# Environment: development | production | test
NODE_ENV=development

# MongoDB Atlas Connection URI
# e.g., mongodb+srv://username:password@cluster.mongodb.net/orange_pulp?retryWrites=true&w=majority
# If omitted in development/testing, an embedded in-memory MongoDB will be used automatically.
MONGODB_URI=

# JWT Secret for signing participation tokens and reward codes
JWT_SECRET=orange_pulp_super_secret_jwt_key_2025_juicy

# Frontend Client URL for CORS
CLIENT_URL=http://localhost:5173

# Campaign Identifier
CAMPAIGN_ID=CAMP-ORANGE-2025
